# Do not use a VITE_ prefix. These values are read only by the Vercel server function.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://code.rayinai.com/v1
OPENAI_MODEL=gpt-5.6-luna
AI_FALLBACK_URL=https://interview-margin.vercel.app/api/ai-chat
# AI reliability limits. OPENAI_TOKEN_LIMIT_FIELD may be max_tokens or max_completion_tokens.
AI_MAX_OUTPUT_TOKENS=1200
AI_SCORE_MAX_OUTPUT_TOKENS=900
AI_SCORE_MAX_OUTPUT_CHARS=8000
AI_MAX_CONCURRENCY=4
AI_FIRST_TOKEN_TIMEOUT_MS=15000
AI_REQUEST_TIMEOUT_MS=60000
OPENAI_TOKEN_LIMIT_FIELD=max_completion_tokens

# Local production server. Keep HOST on loopback when Cloudflare Tunnel is used.
HOST=127.0.0.1
PORT=4173
APP_ORIGINS=https://interview.linsk27.dpdns.org,https://interview-margin.vercel.app,http://127.0.0.1:4173,http://localhost:5173

# Optional. Leave empty to generate a random one-time administrator password.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
