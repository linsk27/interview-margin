[Unit]
Description=Create an online Interview Margin SQLite backup
Documentation=file:/opt/interview-margin/current/ops/linux/README.md
After=local-fs.target
RequiresMountsFor=/opt/interview-margin/current /var/lib/interview-margin

[Service]
Type=oneshot
User=interview-margin
Group=interview-margin
WorkingDirectory=/opt/interview-margin/current
EnvironmentFile=/etc/interview-margin/app.env
Environment=NODE_ENV=production
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
UMask=0077

ExecStartPre=/usr/bin/bash /opt/interview-margin/current/ops/linux/db-preflight.sh backup
ExecStart=/usr/bin/env node server/backup.js

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=10min

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/interview-margin /opt/interview-margin/current/data /opt/interview-margin/current/backups
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=interview-margin-backup
